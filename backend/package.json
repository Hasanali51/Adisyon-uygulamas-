      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ],
    "assets": [],
    "outputPath": "derlenen"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.22.0"
  }
}
