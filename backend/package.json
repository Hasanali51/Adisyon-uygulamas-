{
  "name": "adisyo-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "derle": "pkg . --out-path derlenen"
  },
  "pkg": {
