# Sunucunun dinleyeceği port
PORT=4000

# Uygulamanın (frontend) çalıştığı adres(ler) - CORS için. Virgülle birden fazla yazılabilir.
CORS_ORIGIN=http://localhost:5173

# /api/durum yazma isteklerini korumak için basit bir anahtar (opsiyonel ama önerilir).
# Boş bırakırsan koruma devre dışı kalır.
API_KEY=

# Her platform için ayrı gizli anahtar. Trendyol/Getir/Yemeksepeti webhook isteğinde
# bu değeri bir header ile (x-webhook-secret) gönderecek şekilde entegrasyonunu kur.
# Resmi partner API'sine bağlandığında oradan gelen imza/anahtar doğrulamasını
# webhookDogrula() fonksiyonunun içine sen ekleyeceksin (server.js).
WEBHOOK_SECRET_TRENDYOL=
WEBHOOK_SECRET_GETIR=
WEBHOOK_SECRET_YEMEKSEPETI=
